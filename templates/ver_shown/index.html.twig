{% extends isUserLogged %}

{% block title %}Ver - {{ ver.username }}{% endblock %}

{% block content %}
    <div class="ver-pleine-page">
        <div class="link-to-profile" data-id="{{ ver.pid }}">
            <strong>{{ ver.username }}</strong>
        </div>
        <div class="content">
            {{ ver.content }}
        </div>
        <div class="stats">
            <form method="post" action="/like-adding/{{ ver.id }}">
                <button class="{% if alreadyLiked %}liked{% else %}not-liked{% endif %}" name="like" value="{% if alreadyLiked %}liked{% else %}not-liked{% endif %}">
                    {% if alreadyLiked %}
                        ♥
                    {% else %}
                        ♡
                    {% endif %}
                </button>
                Likes : {{ ver.likes }}
            </form>
            Comments : {{ ver.comments }}
            Shares : {{ ver.shares }}
        </div>
        <div class="date">
            {{ ver.date|date('d/m/Y H:i') }}
        </div>
        {% if app.user %}
            <div class="add-comment">
                {{ form_start(commentForm) }}
                {{ form_widget(commentForm) }}
                <button type="submit" class="btn">Envoyer mon commentaire</button>
                {{ form_end(commentForm) }}
            </div>
        {% endif %}

    </div>

    <div class="responses">
        {% for response in responses %}
            <div class="response">
            {{ response.content }}
            </div>
        {% endfor %}
    </div>
{% endblock %}
