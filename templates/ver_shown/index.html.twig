{% extends isUserLogged %}

{% block title %}Ver - {{ ver.username }}{% endblock %}

{% block content %}
    <div class="ver-pleine-page">
        <div class="auteur">
            <strong>{{ ver.username }}</strong>
        </div>
        <div class="content">
            {{ ver.content }}
        </div>
        <div class="stats">
            <button type="submit" id="like" class="under-ver-button">♥</button> : {{ ver.likes }}
            Comments : {{ ver.comments }}
            Shares : {{ ver.shares }}
        </div>
        <div class="date">
            {{ ver.date|date('d/m/Y H:i') }}
        </div>
    </div>

    <div class="responses">
        {% for response in responses %}
            <div class="response">
            {{ response.content }}
            </div>
        {% endfor %}
    </div>
{% endblock %}
