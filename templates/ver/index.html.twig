{% extends '_layouts/in_app.html.twig' %}

{% block title %}Publier un Ver - Archibald{% endblock %}

{% block content %}
    <style>
        :root {
            --archibald-primary: #42b983;
            --archibald-text: #2c3e50;
            --archibald-bg: #f9fbf9;
        }

        .publish-container {
            max-width: 480px;
            margin: 80px auto;
            padding: 40px;
            background: #ffffff;
            border-radius: 30px;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.05);
            text-align: center;
            position: relative;
        }


        .logo-main {
            width: 100px;
            height: 100px;
            margin: -90px auto 20px auto;
            border-radius: 50%;
            background: white;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .logo-main img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .publish-container h1 {
            font-size: 1.5rem;
            color: var(--archibald-text);
            margin-bottom: 30px;
            font-weight: 700;
        }

        .form-row {
            margin-bottom: 25px;
        }


        .publish-container textarea,
        .publish-container input {
            width: 100%;
            border: 2px solid #f0f0f0;
            border-radius: 20px;
            padding: 18px;
            font-size: 1rem;
            background-color: #fafafa;
            transition: all 0.25s ease;
            box-sizing: border-box;
            resize: none;
        }

        .publish-container textarea:focus {
            outline: none;
            border-color: var(--archibald-primary);
            background-color: #fff;
            box-shadow: 0 5px 15px rgba(66, 185, 131, 0.1);
        }

        .btn-publish {
            width: 100%;
            background-color: var(--archibald-primary);
            color: white;
            border: none;
            padding: 18px;
            font-size: 1.1rem;
            font-weight: 700;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-publish:hover {
            background-color: #3aa876;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(66, 185, 131, 0.2);
        }

        .btn-publish:active {
            transform: translateY(0);
        }

        .form-errors {
            color: #e74c3c;
            font-size: 0.9rem;
            margin-top: 10px;
        }


        label { display: none; }
    </style>

    <div class="publish-container">
        <div class="logo-main">
            <img src="{{ asset('img/logo_archibald.png') }}" alt="Archibald">
        </div>

        <h1>Un ver à partager ?</h1>

        {{ form_start(verForm) }}
        <div class="form-row">
            {{ form_widget(verForm, {'attr': {'placeholder': 'Que veux tu dire ?', 'rows': '4'}}) }}

            {% if form_errors(verForm) %}
                <div class="form-errors">
                    {{ form_errors(verForm) }}
                </div>
            {% endif %}
        </div>

        <button type="submit" class="btn-publish">
            Lâcher le ver !!
        </button>
        {{ form_end(verForm) }}
    </div>
{% endblock %}
