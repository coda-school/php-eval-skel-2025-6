{% extends path %}

{% block title %}Accueil - Archibald{% endblock %}

{% block content %}


<hgroup class="main-title">
    <h1>Bienvenue sur Archibald.fr !</h1>
    {% if isUserLogged %}
        <h4>Tendances</h4>
    {% else %}
        <h4>Consultez les tendances ou connectez vous à votre compte</h4>
    {% endif %}
</hgroup>

<div class="unlogged-feed">
    {% for ver in trendingVers %}
        <div class="trending ver">
            <strong>{{ ver.username }}</strong> - {{ ver.date|date('d/m/Y H:i') }}<br>
            {{ ver.content }}<br>
            <button type="submit" id="like" class="under-ver-button">♥</button> Likes : {{ ver.likes }}
        </div>
    {% endfor %}
</div>
{% endblock %}
