{% extends '_layouts/in_app.html.twig' %}

{% block title %}Accueil - Archibald{% endblock %}

{% block content %}

    <hgroup class="main-title">
        <h1>Bienvenue sur Archibald.fr !</h1>
        <h4>Suivis</h4>
    </hgroup>


    <div class="logged-feed">
        {% if noVers %}
            <p>Vous ne suivez personne pour l'instant...</p>
        {% else %}
            {% for ver in vers %}
                <div class="trending ver">
                    <strong>{{ ver.username }}</strong> - {{ ver.date|date('d/m/Y H:i') }}<br>
                    {{ ver.content }}<br>
                    <div class="ver-stats">
                        Likes : {{ ver.likes }}
                        Commentaires : {{ ver.comments }}
                        Partages : {{ ver.shares }}
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>

{% endblock %}
